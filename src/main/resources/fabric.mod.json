{
  "schemaVersion": 1,
  "id": "payload",
  "version": "${version}",
  "name": "Payload",
  "description": "A simple registry mod for Minecraft.",
  "authors": [
    "MidvightMirage",
    "MaxURhino"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "icon": "assets/payload/icon.png",
  "entrypoints": {
    "fabric-datagen": [
      "midvightmirage.payload.client.datagen.PayloadDataGenerator"
    ],
    "client": [
      "midvightmirage.payload.client.PayloadClient"
    ],
    "main": [
      "midvightmirage.payload.Payload"
    ],
    "modmenu": [
      "midvightmirage.payload.compat.modmenu.PayloadModMenuCompat"
    ]
  },
  "accessWidener": "payload.accesswidener",
  "mixins": [
    "payload.mixins.json",
    {
      "environment": "client",
      "config": "payload.client.mixins.json"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "cloth-config": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ],
      "wip": true
    }
  }
}
